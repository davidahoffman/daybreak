# Copy to .env (gitignored). launchd jobs don't see your shell env, so keys live here.

# Required: in-call voice (Claude) and audio (OpenAI speech-to-text + text-to-speech)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: point either side at a compatible gateway
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_BASE_URL=https://api.openai.com

# The brain (overnight gather). Defaults: run `claude -p` from this folder.
# Point the cwd at the directory whose MCP servers and notes the brain should use.
# DAYBREAK_BRAIN_CWD=/Users/you/notes
# DAYBREAK_BRAIN_CMD=claude -p --dangerously-skip-permissions --model sonnet
# DAYBREAK_PREFETCH_MODEL=sonnet
# DAYBREAK_PROMPT=/Users/you/notes/daybreak-prompt.md

# Optional: Slack voicemail leg ("slackLeg": true in state/config.json)
# SLACK_BOT_TOKEN=xoxb-...            # scopes: files:write, files:read
# DAYBREAK_SLACK_WEBHOOK=https://hooks.slack.com/triggers/...   # Workflow Builder webhook
